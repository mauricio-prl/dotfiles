// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {},
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "colorize_brackets": true,
  "confirm_quit": true,
  "icon_theme": "Catppuccin Macchiato",
  "agent": {
    "favorite_models": [],
    "dock": "right",
    "tool_permissions": {
      "default": "confirm"
    },
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex"
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5"
    },
    "default_profile": "write",
    "model_parameters": [],
    "play_sound_when_agent_done": "when_hidden",
    "sandbox_permissions": {
      "allow_all_hosts": true
      // "allow_unsandboxed": true
    }
  },
  "autosave": "on_focus_change",
  "base_keymap": "VSCode",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 14.5,
  "cursor_shape": "hollow",
  "format_on_save": "on",
  // "format_on_save": "off",
  "formatter": "language_server",
  "git": {
    "blame": {
      "show_avatar": true
    },
    "git_gutter": "tracked_files",
    // "inline_blame": {
    //   "enabled": false
    // }
  },
  "outline_panel": {
    "git_status": false,
    "dock": "right"
  },
  "project_panel": {
    // "git_status": false,
    "dock": "left"
  },
  "scrollbar": {
    // "git_diff": false
  },
  "tabs": {
    "git_status": false
  },
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 2,
    "runnables": false,
    "breakpoints": false,
    "folds": false
  },
  "hard_tabs": false,
  "hide_mouse": "on_typing",
  "hover_popover_enabled": true,
  "line_indicator_format": "short",
  "preferred_line_length": 9999,
  "relative_line_numbers": "enabled",
  "remove_trailing_whitespace_on_save": true,
  "show_whitespaces": "all",
  "soft_wrap": "none",
  "tab_size": 2,
  "theme": "Catppuccin Mocha",
  "ui_font_family": "FiraCode Nerd Font",
  "vertical_scroll_margin": 10,
  "vim_mode": true,
  "indent_guides": {
    "enabled": false
  },
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true,
    "show_parameter_hints": false,
    "show_type_hints": false
  },
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [],
    "mode": "eager"
  },
  "terminal": {
    "copy_on_select": true,
    "default_width": 1000,
    "dock": "bottom",
    "font_family": "FiraCode Nerd Font"
  },
  "wrap_guides": [
    100
  ],
  "sticky_scroll": {
    "enabled": false
  },
  "lsp": {
    "ruby-lsp": {
      "binary": {
        "path": "/Users/mauriciolima/.asdf/shims/ruby-lsp",
        "arguments": []
      },
      "initialization_options": {}
    },
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false
      }
    },
    "solargraph": {
      "binary": {
        "path": "/Users/mauriciolima/.asdf/shims/solargraph",
        "arguments": [
          "stdio"
        ]
      },
      "initialization_options": {
        "diagnostics": true,
        "formatting": true
      }
    },
    "elixir-ls": {
      "settings": {
        "dialyzerEnabled": false
      }
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "!fuzzy-ruby-server",
        "!rubocop",
        "!solargraph",
        "!sorbet",
        "!steep",
        "!kanayago",
        "..."
      ]
    },
    "Elixir": {
      "language_servers": [
        "!next-ls",
        "!lexical",
        "elixir-ls",
        "..."
      ]
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    },
    "HTML+ERB": {
      "format_on_save": "off"
    }
  }
}
